{
	"name": "LS_Practice_Sql",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"description": "Practice linked service for parameterization.",
		"parameters": {
			"ServerName": {
				"type": "string"
			},
			"DatabaseName": {
				"type": "string"
			},
			"Password": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "SqlServer",
		"typeProperties": {
			"server": "@{linkedService().ServerName}",
			"database": "@{linkedService().DatabaseName}",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "E2EIS_ETL",
			"password": "@{linkedService().Password}"
		}
	}
}